{
  "schemaVersion": 1,
  "id": "adhd_client",
  "version": "${version}",
  "name": "ADHD Client",
  "description": "Eigener Client mit vielen Modulen (Base Finder, Block ESP, ESP, Full Bright, Free Cam, Free Look, Blink, RTPQ Invsee, Inspect All, Packet Tools, Lucky Casino), die einzeln über ein Menü an/aus geschaltet werden.",
  "authors": ["redstone_nugget"],
  "license": "MIT",
  "icon": "assets/adhd_client/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.adhdclient.core.AdhdClientClient"],
    "modmenu": ["com.adhdclient.compat.ModMenuIntegration"]
  },
  "mixins": [
    "adhd_client_basefinder.mixins.json",
    "adhd_client_blockesp.mixins.json",
    "adhd_client.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
